---
import { Icon } from "astro-icon/components";
import Prose from "../../components/Prose.astro";
import Default from "../../layouts/Default.astro";
import BlogList from "../../components/BlogList.astro";
import Link from "../../components/Link.astro";
import Badge from "../../components/Badge.astro";
import { getPosts } from "../../utils";

const posts = await getPosts()
const tags = [...new Set(posts.flatMap(post => post.data.tag))]

const page = {
	data: posts.slice(0, 10),
	total: Math.ceil(posts.length / 10)
}
---

<Default title="Blog" titleAppend description="Kumpulan postingan blog seputar coding dan pemrograman, Vue.js, Laravel, Tailwind, JavaScript, PHP, dll.">
    <main>
		<Prose tag="header">
			<h1 class="flex items-center gap-2">
				<Icon name={'twemoji:writing-hand'} />
				Blog
			</h1>
		</Prose>

		<div class="mb-4 flex flex-wrap gap-2">
			{tags.map(tag => <Badge tag="a" href={`/tags/${tag}`} clickable>{tag}</Badge>)}
		</div>
		
		<BlogList posts={page.data} />

		{posts.length > 10 && <nav class="flex items-center relative">
			<div class="flex gap-3 absolute left-1/2 -translate-x-1/2">
				{Array.from({ length: page.total }, (_, i) => i + 1).map(i => <Link tag={i !== 1 ? 'a'  : 'span' } href={i !== 1 ? `/blog/${i}` : null} active={i === 1}>{i}</Link>)}
			</div>

			<Link href="/blog/2" class="flex items-center gap-2 ml-auto">
				Next
				<Icon name={'tabler:arrow-right'} />
			</Link>
		</nav>}
	</main>
</Default>
