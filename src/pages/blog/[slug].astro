---
import Prose from '../../components/Prose.astro';
import Default from '../../layouts/Default.astro';
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Default title={post.data.title} description={post.data.description} image={post.data.thumbnail ? post.data.thumbnail.src : null}>
    <Prose>
        <p class="flex items-center gap-2">
          <span class="text-sm text-neutral-500 dark:text-neutral-400">{dayjs(post.data.date).format('DD MMMM YYYY')}</span>
          <span class="w-1 h-1 bg-neutral-200 rounded-full dark:bg-neutral-600"></span>
          <a href={`/tags/${post.data.tag}`} class="text-sm text-neutral-500 dark:text-neutral-400">{post.data.tag}</a>
        </p>
        <h1>{post.data.title}</h1>
        <Content />
    </Prose>
</Default>
