---
import { Icon } from 'astro-icon/components';
import Prose from '../../components/Prose.astro';
import Default from '../../layouts/Default.astro';
import { Content, frontmatter } from '../../contents/blogs/example.md'

export function getStaticPaths() {
  return [
    { params: { slug: "1" }},
  ];
}
---

<Default title={frontmatter.title} description={frontmatter.description}>
    <Prose>
        <p class="flex items-center gap-2">
          <span class="text-sm text-neutral-500 dark:text-neutral-400">17 Nov 25</span>
          <span class="w-1 h-1 bg-neutral-200 rounded-full dark:bg-neutral-600"></span>
          <a href="" class="text-sm text-neutral-500 dark:text-neutral-400">nodejs</a>
        </p>
        <h1>{frontmatter.title}</h1>
        <Content />
    </Prose>
</Default>