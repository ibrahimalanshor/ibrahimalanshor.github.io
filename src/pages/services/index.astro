---
import { Icon } from "astro-icon/components";
import Prose from "../../components/Prose.astro";
import Default from "../../layouts/Default.astro";
import ServiceList from "../../components/ServiceList.astro";
import { getCollection } from "astro:content";

const services = await getCollection('service')
---

<Default title="Jasa" titleAppend description="Jasa yang saya tawarkan, mulai dari pembuatan website, aplikasi, pengelolaan server, dan mentoring coding">
    <main>
        <Prose tag="header">
            <h1 class="flex items-center gap-2">
                <Icon name={'twemoji:construction-worker'} />
                Jasa
            </h1>
        </Prose>

        <ServiceList services={services} />
    </main>
</Default>