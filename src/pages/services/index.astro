---
import { Icon } from "astro-icon/components";
import Prose from "../../components/Prose.astro";
import Default from "../../layouts/Default.astro";
import ServiceList from "../../components/ServiceList.astro";

const services = [
	{
		icon: 'twemoji:globe-showing-asia-australia',
		name: 'Pembuatan Website',
		description: 'Pembuatan website custom apa saja',
	},
	{
		icon: 'twemoji:hammer-and-wrench',
		name: 'Pembuatan REST API',
		description: 'Pembuatan REST API di backend',
	},
	{
		icon: 'twemoji:man-teacher',
		name: 'Mentoring Coding',
		description: 'Mentor untuk belajar coding',
	},
	{
		icon: 'twemoji:cloud',
		name: 'Setup Server & Deployment',
		description: 'Setup server, domain, SSL, dan deployment website',
	},
]
---

<Default>
    <main>
        <Prose tag="header">
            <h1 class="flex items-center gap-2">
                <Icon name={'twemoji:construction-worker'} />
                Jasa
            </h1>
        </Prose>

        <ServiceList services={services} />
    </main>
</Default>