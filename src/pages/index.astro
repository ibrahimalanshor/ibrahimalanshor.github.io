						<Icon name={"tabler:arrow-right"} />
					</a>
				</li>
				<li class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="w-12 h-12 bg-gray-100 rounded-md flex items-center justify-center">
							<Icon name="twemoji:man-teacher" />
						</div>
						<div>
							<a href="" class="font-semibold">Mentoring Coding</a>
							<p class="text-gray-500">Mentor untuk belajar coding</p>
						</div>
					</div>
					<a href="" class="text-blue-600">
						<Icon name={"tabler:arrow-right"} />
					</a>
				</li>
			</ol>

			<h2 class="font-bold text-2xl mt-8 mb-4 flex items-center gap-2">
				Tulisan Terbaru
			</h2>

			<!-- perlu thumbnail? -->
			 <!-- link warna -->
			  <!-- tag warna perlu abnget? -->
			<ol class="space-y-4 mb-4">
				<li class="flex flex-wrap gap-x-2 items-center">
					<span class="text-gray-500 text-sm">17 Nov</span>
					<span class="w-1 h-1 bg-gray-200 rounded-full"></span>
					<span class="text-sm text-gray-500">nodejs</span>
					<a href="" class="block w-full font-semibold">Apa Itu Peer Dependencies di NPM?</a>
				</li>
				<li class="flex flex-wrap gap-x-2 items-center">
					<span class="text-gray-500 text-sm">9 Nov</span>
					<span class="w-1 h-1 bg-gray-200 rounded-full"></span>
					<span class="text-sm text-gray-500">testing</span>
					<a href="" class="block w-full font-semibold">Memudahkan Testing Elemen HTML dengan atribut data-testid</a>
				</li>
				<li class="flex flex-wrap gap-x-2 items-center">
					<span class="text-gray-500 text-sm">28 Okt</span>
					<span class="w-1 h-1 bg-gray-200 rounded-full"></span>
					<span class="text-sm text-gray-500">docs</span>
