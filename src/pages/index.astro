---
import { Icon } from 'astro-icon/components'
import '@fontsource/inter'
import '@fontsource/fira-mono'
import '../styles/global.css'
import { Content as Bio } from '../contents/bio.md'
import Link from '../components/Link.astro'
import LayoutDefault from '../layouts/Default.astro'
import Prose from '../components/Prose.astro'
import Section from '../components/Section.astro'
import BlogList from '../components/BlogList.astro'
import ProjectList from '../components/ProjectList.astro'
import ServiceList from '../components/ServiceList.astro'
import { getCollection } from 'astro:content'
import { getServices, getPosts } from '../utils'

const services = await getServices()
const posts = await getPosts()
const projects = await getCollection('project')
---

<LayoutDefault>
	<Prose tag="header">
		<h1 class="flex items-center gap-2">
			<Icon name={"twemoji:waving-hand"} />
			Halo! Saya Ibrahim!
		</h1>

		<Bio />
	</Prose>

	<main>
		<Section title="Jasa Saya">
			<ServiceList services={services} />
		</Section>
		{posts.length > 0 && <Section title="Tulisan Terbaru">
			<BlogList posts={posts.slice(0, 10)} />

			{posts.length > 10 && <Link href="/blog" class="ml-auto flex items-center gap-2 sm:ml-0">
				<span>Lihat Lebih Banyak</span>
				<Icon name={"tabler:arrow-right"} />
			</Link>}
		</Section>}
		{projects.length > 0 && <Section title="Proyek">
			<ProjectList projects={projects} />

			{projects.length > 6 && <Link href="/projects" class="ml-auto flex items-center gap-2 sm:ml-0">
				<span>Lihat Lebih Banyak</span>
				<Icon name={"tabler:arrow-right"} />
			</Link>}
		</Section>}
	</main>
</LayoutDefault>