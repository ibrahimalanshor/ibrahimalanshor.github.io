---
import { Icon } from 'astro-icon/components'
import '@fontsource/inter'
import '@fontsource/fira-mono'
import '../styles/global.css'
import { Content as Bio } from '../contents/bio.md'
import Link from '../components/Link.astro'
import LayoutDefault from '../layouts/Default.astro'
import Prose from '../components/Prose.astro'
import Section from '../components/Section.astro'
import BlogList from '../components/BlogList.astro'

const services = [
	{
		icon: 'twemoji:globe-showing-asia-australia',
		name: 'Pembuatan Website',
		description: 'Pembuatan website custom apa saja',
	},
	{
		icon: 'twemoji:hammer-and-wrench',
		name: 'Pembuatan REST API',
		description: 'Pembuatan REST API di backend',
	},
	{
		icon: 'twemoji:man-teacher',
		name: 'Mentoring Coding',
		description: 'Mentor untuk belajar coding',
	},
	{
		icon: 'twemoji:cloud',
		name: 'Setup Server & Deployment',
		description: 'Setup server, domain, SSL, dan deployment website',
	},
]

const posts = [
	{
		date: '17 Nov',
		tag: 'nodejs',
		title: 'Apa Itu Peer Dependencies di NPM?'
	},
	{
		date: '9 Nov',
		tag: 'testing',
		title: 'Memudahkan Testing Elemen HTML dengan atribut data-testid'
	},
	{
		date: '28 Okt',
		tag: 'docs',
		title: 'Vitepress VS Stralight, Mana yang Lebih Baik untuk Dokumentasi'
	},
	{
		date: '26 Okt',
		tag: 'javascript',
		title: 'Kapan Menggunakan let di Javascript'
	},
	{
		date: '14 Okt',
		tag: 'mysql',
		title: 'Query Rekursi di MySQL'
	},
]

const projects = [
	{
		icon: 'twemoji:clipboard',
		name: 'Todoin',
		description: 'Aplikasi todo list',
	},
	{
		icon: 'twemoji:dollar-banknote',
		name: 'Catatin',
		description: 'Aplikasi pencatatan keuangan',
	},
	{
		icon: 'twemoji:mosque',
		name: 'Muslim Kit',
		description: 'Al-Quran, Hadis dan Fatwa Ulama',
	},
	{
		icon: 'twemoji:flag-saudi-arabia',
		name: 'Irabin',
		description: 'Belajar irab dan auto irab',
	},
	{
		icon: 'twemoji:desktop-computer',
		name: 'HTML Playground',
		description: 'Live online HTML Playground',
	},
	{
		icon: 'twemoji:sun-behind-rain-cloud',
		name: 'Mam CCTV',
		description: 'Aplikasi monitoring CCTV jogja',
	},
]
---

<LayoutDefault>
	<Prose tag="header">
		<h1 class="flex items-center gap-2">
			<Icon name={"twemoji:waving-hand"} />
			Halo! Saya Ibrahim!
		</h1>

		<Bio />
	</Prose>

	<main>
		<Section title="Jasa Saya">
			<ul class="grid gap-4 sm:grid-cols-2">
				{services.map(service => <li class="flex items-center gap-2 dark:sm:bg-neutral-800 sm:flex-col sm:items-start sm:bg-neutral-100 sm:p-4 sm:rounded-md">
					<div class="w-12 h-12 shrink-0 bg-neutral-100 rounded-md flex items-center justify-center dark:bg-neutral-800 sm:bg-transparent sm:w-auto sm:h-auto">
						<Icon name={service.icon} class={"size-5 sm:size-6"} />
					</div>
					<div>
						<Link class="font-medium" color="light">{service.name}</Link>
						<p class="text-neutral-500 line-clamp-1 dark:text-neutral-400">{service.description}</p>
					</div>
					<Link class="ml-auto flex items-center gap-2 sm:ml-0">
						<span class="hidden sm:inline">Cek di sini</span>
						<Icon name={"tabler:arrow-right"} />
					</Link>
				</li>)}
			</ul>
		</Section>
		<Section title="Tulisan Terbaru">
			<BlogList posts={posts} />

			<Link class="ml-auto flex items-center gap-2 sm:ml-0">
				<span>Lihat Lebih Banyak</span>
				<Icon name={"tabler:arrow-right"} />
			</Link>
		</Section>
		<Section title="Proyek">
			<ul class="grid grid-cols-1 gap-4 mb-4 sm:grid-cols-2">
				{projects.map(project => <li class="flex items-center gap-4 sm:bg-neutral-100 sm:p-4 sm:rounded-md sm:flex-col sm:items-start sm:gap-2 dark:sm:bg-neutral-800">
					<Icon name={project.icon} class={"shrink-0 size-8 sm:size-6"} />
					<div>
						<Link class="font-medium" color="light">{project.name}</Link>
						<p class="text-neutral-500 dark:text-neutral-400">{project.description}</p>
					</div>
					<Link class="ml-auto flex items-center gap-2 sm:ml-0">
						<span class="hidden sm:inline">Detail</span>
						<Icon name={"tabler:arrow-right"} />
					</Link>
				</li>)}
			</ul>

			<Link class="ml-auto flex items-center gap-2 sm:ml-0">
				<span>Lihat Lebih Banyak</span>
				<Icon name={"tabler:arrow-right"} />
			</Link>
		</Section>
	</main>
</LayoutDefault>