							<p class="text-gray-500">Al-Quran, Hadis dan Fatwa Ulama</p>
						</div>
					</div>
					<a href="">
						<Icon name="tabler:arrow-right" class="text-blue-600" />
					</a>
				</li>
				<li class="flex items-center justify-between">
					<div class="flex items-center gap-4">
						<Icon name={"twemoji:flag-saudi-arabia"} size={32} />
						<div>
							<a href="" class="font-semibold">Irabin</a>
							<p class="text-gray-500">Belajar irab dan auto irab</p>
						</div>
					</div>
					<a href="">
						<Icon name="tabler:arrow-right" class="text-blue-600" />
					</a>
				</li>
				<li class="flex items-center justify-between">
					<div class="flex items-center gap-4">
						<Icon name={"twemoji:desktop-computer"} size={32} />
						<div>
							<a href="" class="font-semibold">HTML Playground</a>
							<p class="text-gray-500">Live online HTML Playground</p>
						</div>
					</div>
					<a href="">
						<Icon name="tabler:arrow-right" class="text-blue-600" />
