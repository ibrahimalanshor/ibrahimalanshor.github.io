---
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'
import dayjs from 'dayjs'

interface Props {
    posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

posts.sort((a, b) => dayjs(b.data.date) - dayjs(a.data.date))
console.log(posts)
---

<ol class="space-y-4 mb-4">
    {posts.map(post => <li class="flex flex-wrap gap-x-2 items-center">
        <span class="text-sm text-neutral-500 dark:text-neutral-400">{dayjs(post.data.date).format('DD MMM')}</span>
        <span class="w-1 h-1 bg-neutral-200 rounded-full dark:bg-neutral-600"></span>
        {post.data.tag.map(tag => <a href={`/tags/${tag}`} class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-sky-700 dark:hover:text-neutral-300">
          {tag}
        </a>)}
        <div class="w-full">
            <Link href={`/blog/${post.id}`} class="font-medium" color="light">{post.data.title}</Link>
        </div>
    </li>
    )}
</ol>
