---
const { class: classes = '', color = 'primary', tag: Tag = 'a', ...props } = Astro.props
---

<Tag {...props} class={`${color === 'primary' ? 'text-sky-700 hover:underline dark:text-sky-300' : 'text-neutral-900 hover:text-sky-700 dark:text-neutral-100 dark:hover:text-neutral-300'} ${classes}`}>
    <slot /> 
</Tag>