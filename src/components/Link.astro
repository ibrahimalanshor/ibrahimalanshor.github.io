---
const { class: classes = '', color = 'primary', tag: Tag = 'a', active = false, ...props } = Astro.props

const activeClass = 'font-medium text-neutral-500 underline dark:text-neutral-400'
const primaryClass = 'text-sky-700 hover:underline dark:text-sky-300'
const defaultClass = 'text-neutral-900 hover:text-sky-700 dark:text-neutral-100 dark:hover:text-neutral-300'

const colorClass = active ? activeClass : color === 'primary' ? primaryClass : defaultClass
---

<Tag {...props} class={`${colorClass} ${classes}`}>
    <slot /> 
</Tag>