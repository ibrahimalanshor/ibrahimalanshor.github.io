---
import { Icon } from "astro-icon/components";
import Link from "./Link.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    projects: CollectionEntry<'project'>[]
}

const { projects } = Astro.props
---

<ul class="grid grid-cols-1 gap-4 mb-4 sm:grid-cols-2">
    {projects.map(project => <li class="flex items-center gap-4 sm:bg-neutral-100 sm:p-4 sm:rounded-md sm:flex-col sm:items-start sm:gap-2 dark:sm:bg-neutral-800">
        <Icon name={project.data.icon} class={"shrink-0 size-8 sm:size-6"} />
        <div>
            <Link href={`/projects/${project.id}`} class="font-medium" color="light">{project.data.title}</Link>
            <p class="text-neutral-500 dark:text-neutral-400">{project.data.summary}</p>
        </div>
        <Link href={`/projects/${project.id}`} class="ml-auto flex items-center gap-2 sm:ml-0" title="Detail">
            <span class="hidden sm:inline">Detail</span>
            <Icon name={"tabler:arrow-right"} />
        </Link>
    </li>)}
</ul>