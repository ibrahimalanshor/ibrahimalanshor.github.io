---
import { Icon } from 'astro-icon/components'
import '@fontsource/inter'
import '@fontsource/fira-mono'
import '../styles/global.css'
import Link from '../components/Link.astro'
import { SEO } from "astro-seo";

const navMenus = [
	{ href: '/about', name: 'Tentang' },
	{ href: '/blog', name: 'Blog' },
	{ href: '/projects', name: 'Proyek' },
	{ href: '/services', name: 'Jasa' }
]

const socials = [
	{
		color: 'hover:bg-blue-600',
		icon: 'tabler:brand-linkedin',
		name: 'Linkedin',
	},
	{
		color: 'hover:bg-indigo-600',
		icon: 'tabler:brand-instagram',
		name: 'Instagram',
	},
	{
		color: 'hover:bg-sky-600',
		icon: 'tabler:brand-twitter',
		name: 'Twitter',
	},
	{
		color: 'hover:bg-blue-600',
		icon: 'tabler:brand-facebook',
		name: 'Facebook',
	},
	{
		color: 'hover:bg-gray-600',
		icon: 'tabler:brand-github',
		name: 'Github',
	},
	{
		color: 'hover:bg-red-600',
		icon: 'tabler:brand-youtube',
		name: 'Youtube',
	},
]
---

<html lang="id" class="text-[16px] text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100 sm:text-[18px]">
	<head>
		<SEO
			charset='utf-8'
			title='Ibrahim Al-Anshor | Personal Website'
			description="Saya seorang Web Developer, biasa menggunakan Vue.js dan Laravel. Di blog ini saya akan berbagi tulisan seputar coding dan proyek aplikasi yang saya kembangkan."
			openGraph={{
				basic: {
					title: "Ibrahim Al-Anshor | Personal Website",
					type: "website",
					image: "https://user-images.githubusercontent.com/5182256/131216951-8f74f425-f775-463d-a11b-0e01ad9fce8d.png",
				},
				optional: {
					description: 'Saya seorang Web Developer, biasa menggunakan Vue.js dan Laravel'
				}
			}}
			twitter={{
				card: 'summary',
				creator: "@ibrahiminx",
				title: 'Ibrahim Al-Anshor | Personal Website',
				image: "https://user-images.githubusercontent.com/5182256/131216951-8f74f425-f775-463d-a11b-0e01ad9fce8d.png",
				description: 'Saya seorang Web Developer, biasa menggunakan Vue.js dan Laravel'
			}}
			extend={{
				link: [{ rel: "icon", href: "/favicon.svg" }],
			}}
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<script>
			document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark' || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches))
		</script>
	</head>
	<body class="max-w-screen-md mx-auto">

		<nav class="p-4 flex items-center justify-between gap-2 relative sm:p-6">
			<button class="group cursor-pointer hover:text-sky-700 dark:hover:text-neutral-300 sm:hidden" title="Buka Menu Navigasi" data-toggle="dropdown" data-target="#nav-menu">
				<Icon name={"tabler:menu-2"} class={'block group-[.active]:hidden'} />
				<Icon name={"tabler:x"} class={'hidden group-[.active]:block'} />
			</button>
			<Link href="/" color="light" class="font-bold">Ibrahim Al-Anshor</Link>
			<div class="flex items-center gap-4">
				<div id="nav-menu" class="hidden absolute top-16 left-0 flex flex-col gap-4 bg-white w-full px-4 pb-4 shadow-lg dark:bg-neutral-900 sm:flex sm:static sm:top-0 sm:left-0 sm:flex-row sm:p-0 sm:shadow-none sm:w-auto">
					{navMenus.map(menu => <a href={menu.href} class={`hover:text-sky-700 dark:hover:text-neutral-300 ${Astro.url.pathname === menu.href ? 'text-sky-700 sm:text-sky-700 dark:text-white dark:sm:text-white' : 'sm:text-neutral-500 dark:text-neutral-400 dark:sm:text-neutral-400'}`}>{menu.name}</a>)}
				</div>
				<button class="cursor-pointer hover:text-sky-700 dark:hover:text-neutral-300 sm:text-neutral-500 dark:sm:text-neutral-400" title="Ganti ke Mode Gelap / Terang" id="toggle-theme">
					<Icon name={"tabler:moon"} class={"dark:hidden"} />
					<Icon name={"tabler:sun"} class={"hidden dark:block"} />
				</button>
			</div>
		</nav>

		<div class="px-4 py-8 sm:px-6 sm:py-10">
			<slot />

			<footer class="mt-8 pt-4 text-center space-y-2 text-neutral-500">
				<div class="flex flex-wrap justify-center gap-2">
					{socials.map(social => <a href="" title={social.name} class={`w-10 h-10 bg-neutral-100 rounded-full flex items-center justify-center gap-2 hover:text-white ${social.color} dark:bg-neutral-800`}>
						<Icon name={social.icon} />
					</a>)}
				</div>
			</footer>
		</div>
	</body>

	<script>
		const toggles = document.querySelectorAll<HTMLButtonElement>('[data-toggle]')

		toggles.forEach(toggle => {
			toggle.addEventListener('click' , () => {
				if (toggle.dataset.target) {
					const target = document.querySelector(toggle.dataset.target)

					if (target) {
						if (toggle.classList.contains('active')) {
							target.classList.add('hidden')
							target.classList.add('animate-slide')
							toggle.classList.remove('active')
						} else {
							target.classList.remove('hidden')
							target.classList.add('animate-slide')
							toggle.classList.add('active')
						}
					}
				}
			})
		})

		const toggleThemeBtn = document.querySelector('#toggle-theme')

		if (toggleThemeBtn) {
			toggleThemeBtn.addEventListener('click', () => {
				localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'light' : 'dark')

				document.documentElement.classList.toggle('dark')
			})
		}
	</script>
</html>
